# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://medcampus_user:password@localhost:5432/medcampus_db"

# ─── JWT ───────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GANTI_INI_DENGAN_RANDOM_64_CHAR_STRING
JWT_REFRESH_SECRET=GANTI_INI_DENGAN_RANDOM_64_CHAR_STRING_BERBEDA
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
